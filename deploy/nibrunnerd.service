[Unit]
Description=nibrunner app host
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/nibrunnerd

Restart=always
RestartSec=5s

StateDirectory=nibrunner
RuntimeDirectory=nibrunner
RuntimeDirectoryPreserve=yes

NoNewPrivileges=false

LimitNOFILE=524288

# Nothing this daemon does stops a tenant, and neither should its death: at the memory
# ceiling the kernel picked it over the microVMs it exists to manage.
OOMScoreAdjust=-1000

# A microVM is a child of this daemon and so sits in this unit's cgroup, which systemd's
# default KillMode empties on stop. setsid gives each one its own session, and a session
# is not a cgroup: without this a restart of the daemon takes every tenant with it.
KillMode=process

LogExtraFields=SOURCE=nibrunnerd

[Install]
WantedBy=multi-user.target
