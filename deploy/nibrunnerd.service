[Unit]
Description=nibrunner app host
After=network-online.target
Wants=network-online.target

[Service]
# Started means serving: the daemon says READY=1 once its host is built and every controller
# runs, so a start that returns is one it serves after, and one that exits binding a listener it
# was given fails the start rather than the next five-second restart.
Type=notify
ExecStart=/usr/local/bin/nibrunnerd

Restart=always
RestartSec=5s

StateDirectory=nibrunner
RuntimeDirectory=nibrunner
RuntimeDirectoryPreserve=yes

NoNewPrivileges=false

LimitNOFILE=524288

# Nothing this daemon does stops a tenant, and neither should its death: at the memory
# ceiling the kernel picked it over the microVMs it exists to manage.
OOMScoreAdjust=-1000

# Legacy VMMs and jailers still launching can sit in this unit's cgroup, which systemd's
# default KillMode empties on stop. Their separate sessions do not protect them from it,
# so a daemon restart must signal only the daemon.
KillMode=process

LogExtraFields=SOURCE=nibrunnerd

[Install]
WantedBy=multi-user.target
