[Unit]
Description=nibrunner app host
After=network-online.target
Wants=network-online.target

# Deliberately not BindsTo or Requires on anything: the daemon must be restartable, and
# stoppable, without that being an event for anything it manages. A tenant microVM runs in a
# session of its own rather than as a child of this process, so restarting the daemon leaves
# every running app alone — it comes back and converges against what it finds.

[Service]
Type=exec
ExecStart=/usr/local/bin/nibrunnerd

# The daemon reads /etc/nibrunner/config.toml, and reads it once: a changed file is a restart and
# not a reload, because what it configures is where this host keeps everything and moving that
# under a running daemon would leave half its state behind.
#
# Not named here as NIBRUNNER_CONFIG, though that would be the more discoverable spelling. That
# variable means "this exact file, and fail if it is not there", which is what an operator wants
# when they point at a file deliberately. The path below is the default, and a default is allowed
# to be absent — which is what lets this unit start a host that has not been configured yet.

Restart=always
RestartSec=5s

StateDirectory=nibrunner
RuntimeDirectory=nibrunner
# systemd removes a RuntimeDirectory when its unit stops, and what lives in this one belongs to
# the microVMs rather than to the daemon: each Firecracker holds its API socket there and keeps
# running across a restart. Removing it takes away the only handle on a VM that outlived the
# daemon, which is precisely the case the VMs are put in their own session to survive.
RuntimeDirectoryPreserve=yes

# It creates tap devices, writes firewall rules and starts microVMs, so it runs as root.
# Containerising it would hand back every privilege the container removed.
NoNewPrivileges=false

# What this unit is called in the log store. journald attaches this to every entry the unit
# writes, and systemd requires the field name to be uppercase.
LogExtraFields=SOURCE=nibrunnerd

[Install]
WantedBy=multi-user.target
