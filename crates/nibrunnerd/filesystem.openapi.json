{
  "components": {
    "schemas": {
      "AppId": {
        "description": "an identifier",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$",
        "type": "string"
      },
      "DeploymentId": {
        "description": "an identifier",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$",
        "type": "string"
      },
      "DirectoryListing": {
        "description": "What one directory inside a guest holds.",
        "properties": {
          "entries": {
            "description": "Sorted by `name`. `lost+found` is left out of the guest's root, because the filesystem\nthe volume was made with put it there and no app did.",
            "items": {
              "$ref": "#/components/schemas/FilesystemEntry"
            },
            "type": "array"
          },
          "path": {
            "$ref": "#/components/schemas/GuestPath",
            "description": "The directory listed, as it was asked for."
          },
          "truncated": {
            "description": "The directory held more entries than one answer carries, and `entries` is cut.",
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "entries",
          "truncated"
        ],
        "type": "object"
      },
      "FilesystemEntry": {
        "description": "One entry of a directory, as the guest measured it.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/FilesystemEntryKind"
          },
          "modifiedAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "name": {
            "description": "The entry alone, not the path it was reached by.",
            "type": "string"
          },
          "sizeBytes": {
            "description": "What the entry takes, as the guest's own filesystem reports it.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "kind",
          "sizeBytes",
          "modifiedAt"
        ],
        "type": "object"
      },
      "FilesystemEntryKind": {
        "description": "What one entry in a directory is. Anything that is neither a file nor a directory — a socket,\na device node, a symbolic link — is `other`.",
        "enum": [
          "file",
          "directory",
          "other"
        ],
        "type": "string"
      },
      "GuestPath": {
        "description": "a guest path",
        "maxLength": 4096,
        "pattern": "^/$|^(/(?!\\.\\.?(/|$))[^/\\\\\"'\\x00-\\x1f]+)+$",
        "type": "string"
      },
      "HranaBatch": {
        "properties": {
          "steps": {
            "items": {
              "$ref": "#/components/schemas/HranaBatchStep"
            },
            "type": "array"
          }
        },
        "required": [
          "steps"
        ],
        "type": "object"
      },
      "HranaBatchCondition": {
        "oneOf": [
          {
            "properties": {
              "step": {
                "format": "int32",
                "type": "integer"
              },
              "type": {
                "const": "ok",
                "type": "string"
              }
            },
            "required": [
              "type",
              "step"
            ],
            "type": "object"
          },
          {
            "properties": {
              "step": {
                "format": "int32",
                "type": "integer"
              },
              "type": {
                "const": "error",
                "type": "string"
              }
            },
            "required": [
              "type",
              "step"
            ],
            "type": "object"
          },
          {
            "properties": {
              "cond": {
                "$ref": "#/components/schemas/HranaBatchCondition"
              },
              "type": {
                "const": "not",
                "type": "string"
              }
            },
            "required": [
              "type",
              "cond"
            ],
            "type": "object"
          },
          {
            "properties": {
              "conds": {
                "items": {
                  "$ref": "#/components/schemas/HranaBatchCondition"
                },
                "type": "array"
              },
              "type": {
                "const": "and",
                "type": "string"
              }
            },
            "required": [
              "type",
              "conds"
            ],
            "type": "object"
          },
          {
            "properties": {
              "conds": {
                "items": {
                  "$ref": "#/components/schemas/HranaBatchCondition"
                },
                "type": "array"
              },
              "type": {
                "const": "or",
                "type": "string"
              }
            },
            "required": [
              "type",
              "conds"
            ],
            "type": "object"
          }
        ]
      },
      "HranaBatchResult": {
        "properties": {
          "step_errors": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/HranaError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "step_results": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/HranaStatementResult"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          }
        },
        "required": [
          "step_results",
          "step_errors"
        ],
        "type": "object"
      },
      "HranaBatchStep": {
        "properties": {
          "condition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HranaBatchCondition"
              },
              {
                "type": "null"
              }
            ]
          },
          "stmt": {
            "$ref": "#/components/schemas/HranaStatement"
          }
        },
        "required": [
          "stmt"
        ],
        "type": "object"
      },
      "HranaColumn": {
        "properties": {
          "decltype": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "HranaDescribeColumn": {
        "properties": {
          "decltype": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "HranaDescribeResult": {
        "properties": {
          "cols": {
            "items": {
              "$ref": "#/components/schemas/HranaDescribeColumn"
            },
            "type": "array"
          },
          "is_explain": {
            "type": "boolean"
          },
          "is_readonly": {
            "type": "boolean"
          },
          "params": {
            "items": {
              "$ref": "#/components/schemas/HranaParameter"
            },
            "type": "array"
          }
        },
        "required": [
          "params",
          "cols",
          "is_explain",
          "is_readonly"
        ],
        "type": "object"
      },
      "HranaError": {
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "HranaNamedArg": {
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/HranaValue"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "type": "object"
      },
      "HranaParameter": {
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "HranaPipelineRequest": {
        "properties": {
          "baton": {
            "type": [
              "string",
              "null"
            ]
          },
          "requests": {
            "items": {
              "$ref": "#/components/schemas/HranaRequest"
            },
            "type": "array"
          }
        },
        "required": [
          "requests"
        ],
        "type": "object"
      },
      "HranaPipelineResponse": {
        "properties": {
          "base_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "baton": {
            "type": [
              "string",
              "null"
            ]
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/HranaStreamResult"
            },
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "type": "object"
      },
      "HranaRequest": {
        "oneOf": [
          {
            "properties": {
              "stmt": {
                "$ref": "#/components/schemas/HranaStatement"
              },
              "type": {
                "const": "execute",
                "type": "string"
              }
            },
            "required": [
              "type",
              "stmt"
            ],
            "type": "object"
          },
          {
            "properties": {
              "batch": {
                "$ref": "#/components/schemas/HranaBatch"
              },
              "type": {
                "const": "batch",
                "type": "string"
              }
            },
            "required": [
              "type",
              "batch"
            ],
            "type": "object"
          },
          {
            "properties": {
              "sql": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sql_id": {
                "format": "int32",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "type": {
                "const": "describe",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "sql": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sql_id": {
                "format": "int32",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "type": {
                "const": "sequence",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "sql": {
                "type": "string"
              },
              "sql_id": {
                "format": "int32",
                "type": "integer"
              },
              "type": {
                "const": "store_sql",
                "type": "string"
              }
            },
            "required": [
              "type",
              "sql_id",
              "sql"
            ],
            "type": "object"
          },
          {
            "properties": {
              "sql_id": {
                "format": "int32",
                "type": "integer"
              },
              "type": {
                "const": "close_sql",
                "type": "string"
              }
            },
            "required": [
              "type",
              "sql_id"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "close",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "HranaResponse": {
        "oneOf": [
          {
            "properties": {
              "result": {
                "$ref": "#/components/schemas/HranaStatementResult"
              },
              "type": {
                "const": "execute",
                "type": "string"
              }
            },
            "required": [
              "type",
              "result"
            ],
            "type": "object"
          },
          {
            "properties": {
              "result": {
                "$ref": "#/components/schemas/HranaBatchResult"
              },
              "type": {
                "const": "batch",
                "type": "string"
              }
            },
            "required": [
              "type",
              "result"
            ],
            "type": "object"
          },
          {
            "properties": {
              "result": {
                "$ref": "#/components/schemas/HranaDescribeResult"
              },
              "type": {
                "const": "describe",
                "type": "string"
              }
            },
            "required": [
              "type",
              "result"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "sequence",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "store_sql",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "close_sql",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "close",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "HranaStatement": {
        "properties": {
          "args": {
            "items": {
              "$ref": "#/components/schemas/HranaValue"
            },
            "type": "array"
          },
          "named_args": {
            "items": {
              "$ref": "#/components/schemas/HranaNamedArg"
            },
            "type": "array"
          },
          "sql": {
            "type": [
              "string",
              "null"
            ]
          },
          "sql_id": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "want_rows": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "HranaStatementResult": {
        "properties": {
          "affected_row_count": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "cols": {
            "items": {
              "$ref": "#/components/schemas/HranaColumn"
            },
            "type": "array"
          },
          "last_insert_rowid": {
            "type": [
              "string",
              "null"
            ]
          },
          "rows": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/HranaValue"
              },
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "cols",
          "rows",
          "affected_row_count"
        ],
        "type": "object"
      },
      "HranaStreamResult": {
        "oneOf": [
          {
            "properties": {
              "response": {
                "$ref": "#/components/schemas/HranaResponse"
              },
              "type": {
                "const": "ok",
                "type": "string"
              }
            },
            "required": [
              "type",
              "response"
            ],
            "type": "object"
          },
          {
            "properties": {
              "error": {
                "$ref": "#/components/schemas/HranaError"
              },
              "type": {
                "const": "error",
                "type": "string"
              }
            },
            "required": [
              "type",
              "error"
            ],
            "type": "object"
          }
        ]
      },
      "HranaValue": {
        "oneOf": [
          {
            "properties": {
              "type": {
                "const": "null",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "integer",
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "float",
                "type": "string"
              },
              "value": {
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "text",
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "properties": {
              "base64": {
                "type": "string"
              },
              "type": {
                "const": "blob",
                "type": "string"
              }
            },
            "required": [
              "type",
              "base64"
            ],
            "type": "object"
          }
        ]
      },
      "Refused": {
        "description": "The body every refusal is answered with.",
        "properties": {
          "message": {
            "description": "Why the listing was refused, as the sentence an operator will find in a log.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "SqliteOperation": {
        "oneOf": [
          {
            "properties": {
              "path": {
                "$ref": "#/components/schemas/GuestPath"
              },
              "root": {
                "$ref": "#/components/schemas/GuestPath"
              },
              "type": {
                "const": "open",
                "type": "string"
              }
            },
            "required": [
              "type",
              "root",
              "path"
            ],
            "type": "object"
          },
          {
            "properties": {
              "body": {
                "$ref": "#/components/schemas/HranaPipelineRequest"
              },
              "type": {
                "const": "pipeline",
                "type": "string"
              }
            },
            "required": [
              "type",
              "body"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "close",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "SqliteOutcome": {
        "oneOf": [
          {
            "properties": {
              "status": {
                "const": "opened",
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          },
          {
            "properties": {
              "status": {
                "const": "closed",
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          },
          {
            "properties": {
              "body": {
                "$ref": "#/components/schemas/HranaPipelineResponse"
              },
              "status": {
                "const": "responded",
                "type": "string"
              }
            },
            "required": [
              "status",
              "body"
            ],
            "type": "object"
          },
          {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "const": "failed",
                "type": "string"
              }
            },
            "required": [
              "status",
              "code",
              "message"
            ],
            "type": "object"
          }
        ]
      },
      "SqliteQuery": {
        "properties": {
          "appId": {
            "$ref": "#/components/schemas/AppId"
          },
          "deploymentId": {
            "$ref": "#/components/schemas/DeploymentId"
          },
          "operation": {
            "$ref": "#/components/schemas/SqliteOperation"
          },
          "sessionId": {
            "$ref": "#/components/schemas/SqliteSessionId"
          }
        },
        "required": [
          "appId",
          "deploymentId",
          "sessionId",
          "operation"
        ],
        "type": "object"
      },
      "SqliteSessionId": {
        "description": "an identifier",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$",
        "type": "string"
      },
      "Timestamp": {
        "description": "an ISO 8601 instant with an offset",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "What a guest holds, over the unix socket `[filesystem] socket` names.",
    "title": "nibrunner guest filesystem",
    "version": "2"
  },
  "openapi": "3.1.0",
  "paths": {
    "/apps/{appId}/files": {
      "get": {
        "description": "A sleeping app is woken first, as a request reaching it would, and asking counts as activity.",
        "parameters": [
          {
            "description": "The app to ask, as `desired.json` names it.",
            "in": "path",
            "name": "appId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AppId"
            }
          },
          {
            "description": "The directory to list, percent-encoded.",
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/GuestPath"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryListing"
                }
              }
            },
            "description": "What the directory holds."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "The app id or the path could not be read, or no path was given, or more was asked of the guest than one request carries."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "The guest would not list that directory."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "The route is not one this socket answers, or this host runs no app by that id."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "The request was not a GET."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "The app is stopped, so there is no guest to ask."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "The guest answered with bytes the host could not read."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "The app could not be woken, or the host has no memory left to wake the app, or no microVM is running for the app."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "The guest took the request and never answered."
          }
        },
        "summary": "List a directory inside an app's guest.",
        "x-codeSamples": [
          {
            "label": "curl",
            "lang": "bash",
            "source": "curl --unix-socket /run/nibrunner/filesystem.sock \\\n  'http://localhost/apps/app-7/files?path=%2Fdata'"
          }
        ]
      }
    },
    "/sqlite": {
      "post": {
        "description": "Sessions belong to one deployment, expire after 30 idle seconds, and close before a deployment stops or is replaced. Open supplies a persistent-volume root and a database path relative to that root. Pipeline carries Hrana v2 requests and never retries SQL.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SqliteQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SqliteOutcome"
                }
              }
            },
            "description": "The SQLite operation's outcome, including any refusal."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "The query is malformed, exceeds the body limit or took too long to arrive."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refused"
                }
              }
            },
            "description": "The request was not a POST."
          }
        },
        "summary": "Open, query or close a read-only SQLite session."
      }
    }
  }
}
