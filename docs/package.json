{
  "name": "docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "bun run --bun vite dev",
    "build": "bun run scripts/build.ts",
    "build:app": "bun run --bun vite build",
    "build:local": "BUILD_TARGET=host bun run build",
    "preview": "bun run --bun vite preview",
    "check:types": "tsc --noEmit",
    "check:lint": "bun run --bun biome check --formatter-enabled=false --config-path=biome.json",
    "check:format": "bun run --bun biome format --config-path=biome.json",
    "fix:lint": "bun run --bun biome check --formatter-enabled=false --write --config-path=biome.json",
    "fix:format": "bun run --bun biome format --write --config-path=biome.json"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.53",
    "@tanstack/start-static-server-functions": "1.167.35",
    "fumadocs-core": "16.15.10",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.10",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "nitro": "3.0.260903-beta",
    "srvx": "^1.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
